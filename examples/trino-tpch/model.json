{
  "version": "0.3.0.dev0",
  "name": "trino_tpch_quickstart",
  "datasets": [
    {
      "name": "orders",
      "source": "tpch.tiny.orders",
      "fields": [
        {
          "name": "custkey",
          "expression": {"sql": "custkey"},
          "datatype": "Integer"
        },
        {
          "name": "totalprice",
          "expression": {"sql": "totalprice"},
          "datatype": "Decimal"
        },
        {
          "name": "orderstatus",
          "expression": {"sql": "orderstatus"},
          "datatype": "String"
        }
      ]
    },
    {
      "name": "customers",
      "source": "tpch.tiny.customer",
      "primary_key": ["custkey"],
      "fields": [
        {
          "name": "custkey",
          "expression": {"sql": "custkey"},
          "datatype": "Integer"
        },
        {
          "name": "mktsegment",
          "expression": {"sql": "mktsegment"},
          "datatype": "String"
        }
      ]
    }
  ],
  "relationships": [
    {
      "name": "orders_customer",
      "from": "orders",
      "to": "customers",
      "from_columns": ["custkey"],
      "to_columns": ["custkey"]
    }
  ],
  "metrics": [
    {
      "name": "revenue",
      "expression": {"sql": "ROUND(SUM(orders.totalprice), 2)"},
      "datatype": "Decimal"
    }
  ]
}
